# 飞牛 fpk 安装后，应用数据默认在：
# /var/apps/youtube-nas-dl/shares/youtube-nas-dl/media
#
# 共享文件夹根目录 SHARES_ROOT：其下一层目录会出现在小应用「保存位置」列表中。
# 本地示例：
#   mkdir -p data/shares/电影 data/shares/电视剧 data/shares/视频
# 飞牛示例：把系统共享卷挂进容器
#   /vol1/1000:/data/shares
#   SHARES_ROOT=/data/shares
#
# MEDIA_ROOT 仍可用于临时下载目录（.tmp）

PORT=4010
MEDIA_ROOT=./data/media
SHARES_ROOT=./data/shares
YT_DLP_PATH=/usr/local/bin/yt-dlp

# 可选：简单鉴权（请求头 Authorization: Bearer <token>）
# DOWNLOAD_TOKEN=

# 可选：YouTube 403 时在容器环境变量里设置
# YT_DLP_COOKIES_FROM_BROWSER=chrome
# YT_DLP_PLAYER_CLIENT=android,web

# fpk 打包用
DOCKERHUB_REPO=xiaofeng19920506/youtube-nas-dl
FPK_VERSION=1.0.0
FPK_IMAGE_TAG=1.0.0
